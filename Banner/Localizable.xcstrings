    "settings.speed.video.footer": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo s'exporta més ràpid que el rètol a la pantalla: està pensat per compartir-lo, no per mirar-lo d'una tirada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video is exported faster than the banner on screen: it is meant to be shared, not watched in place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
