{
  "sourceLanguage": "en",
  "strings": {
    "Could not prepare the video.": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut preparar el vídeo."
