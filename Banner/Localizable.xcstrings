    "path.footer": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lletres pugen i baixen seguint el traç mentre travessen la pantalla. El dibuix es repeteix fins que el missatge acaba de passar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The letters rise and fall along the stroke as they cross the screen. The drawing repeats until the whole message has gone by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las letras suben y bajan siguiendo el trazo mientras cruzan la pantalla. El dibujo se repite hasta que el mensaje termina de pasar."
          }
        }
      }
    },
    "path.instructions": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuixa amb el dit el recorregut, d'esquerra a dreta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the path with your finger, from left to right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja con el dedo el recorrido, de izquierda a derecha."
          }
        }
      }
    },
